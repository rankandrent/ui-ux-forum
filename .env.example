# Copy to .env.local for local development (never commit real values).
# In production set these as Cloudflare Worker secrets: npx wrangler secret put <NAME>

SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

SITE_URL=http://localhost:3000

# Optional — email notifications via Resend (phase 2)
RESEND_API_KEY=
EMAIL_FROM=

# Optional — Cloudflare Turnstile (phase 2)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional — public base URL of the R2 images bucket (phase 2)
R2_PUBLIC_URL=
