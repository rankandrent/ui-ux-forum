# Copy to .env.local for local development (never commit real values).
# In production set these as Cloudflare Worker secrets: npx wrangler secret put <NAME>

SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

SITE_URL=http://localhost:3000

# Only for scripts (db:migrate, db:auth-config) — Supabase personal access token (sbp_…). Not needed by the app.
SUPABASE_ACCESS_TOKEN=

# Set to true once the Google provider is configured in Supabase (shows the Google button).
GOOGLE_AUTH_ENABLED=

# Optional — notification emails via Resend (skipped while empty).
# EMAIL_FROM defaults to "UI/UX Forum <notifications@forum.ui-ux.agency>" (domain must be verified in Resend).
RESEND_API_KEY=
EMAIL_FROM=

# Optional — Cloudflare Turnstile on signup and posting (skipped until both are set).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Images are stored in the R2 bucket bound as FORUM_IMAGES (wrangler.jsonc) and served at /img/….
